static func frames(actor: Node3D) -> Array:
	var result := []
	for part in PARTS:
		var pose: Transform3D = actor.role_pose_boat(part.bone)
		result.append({"pose":pose,"inverse":pose.affine_inverse(),"radius":SURFACE_OFFSET/pose.basis.x.length()})
	return result

static func project_once(point: Vector3, transforms: Array, shaft_start: Vector3 = Vector3.ZERO, shaft_end: Vector3 = Vector3.ZERO, shaft_radius: float = 0.0) -> Vector3:
	for index in PARTS.size():
		var part: Dictionary = PARTS[index]
		var frame: Dictionary = transforms[index]
		var local: Vector3 = frame.inverse*point
		if not part.bounds.grow(frame.radius).has_point(local): continue
		var separation := -INF
		var normal := Vector3.ZERO
		for plane in part.planes:
			var distance: float = plane.x*local.x+plane.y*local.y+plane.z*local.z-plane.w
			if distance>separation:
				separation = distance
				normal = Vector3(plane.x,plane.y,plane.z)
		if separation<frame.radius:
			var projected: Vector3 = frame.pose*(local+normal*(frame.radius-separation))
			if shaft_radius>0 and projected.distance_to(Geometry3D.get_closest_point_to_segment(projected,shaft_start,shaft_end))<shaft_radius:
				var best := INF
				# The thumb and shaft leave no rope-sized tunnel between them.
				# Choose the nearest skin face whose correction also clears the shaft.
				for plane in part.planes:
					var distance: float = plane.x*local.x+plane.y*local.y+plane.z*local.z-plane.w
					var amount: float = frame.radius-distance
					if amount>=best: continue
					var candidate: Vector3 = frame.pose*(local+Vector3(plane.x,plane.y,plane.z)*amount)
					if candidate.distance_to(Geometry3D.get_closest_point_to_segment(candidate,shaft_start,shaft_end))>=shaft_radius:
						best = amount
						projected = candidate
			point = projected
	return point

static func clearance(point: Vector3, transforms: Array) -> float:
	var result := INF
	for index in PARTS.size():
		var local: Vector3 = transforms[index].inverse*point
		var separation := -INF
		for plane in PARTS[index].planes:
			separation = maxf(separation,plane.x*local.x+plane.y*local.y+plane.z*local.z-plane.w)
		result = minf(result,separation*transforms[index].pose.basis.x.length())
	return result
