func _at(role: int,steering: float,hike: float) -> Vector3:
	var x := (clampf(steering,-1,1)+1)*.5*(COUNT-1)
	var y := clampf(hike,0,1)*(COUNT-1)
	var sx := mini(int(x),COUNT-2)
	var hy := mini(int(y),COUNT-2)
	var a := points[(hy*COUNT+sx)*3+role].lerp(points[(hy*COUNT+sx+1)*3+role],x-sx)
	var b := points[((hy+1)*COUNT+sx)*3+role].lerp(points[((hy+1)*COUNT+sx+1)*3+role],x-sx)
	var point := a.lerp(b,y-hy)
	if role<2:
		# Offline correction of the single68.75%/neutral steering cell:
		# lift the working space50mm with C1-zero boundaries. Both stroke
		# ends move together; source geometry and logical travel stay fixed.
		var weight := (1-smoothstep(0,.0625,absf(hike-.6875)))*(1-smoothstep(0,.125,absf(steering)))
		point.y+=.050*weight
	return point
func tiller_at(steering: float,hike: float,progress: float) -> Vector3:
	return _at(0,steering,hike).lerp(_at(1,steering,hike),progress)
func low_at(steering: float,hike: float) -> Vector3: return _at(2,steering,hike)
