static func _cubic(a: Vector3,b: Vector3,c: Vector3,d: Vector3,t: float) -> Vector3:
	return (2*b+(-a+c)*t+(2*a-5*b+4*c-d)*t*t+(-a+3*b-3*c+d)*t*t*t)*.5
func _row(index: int,coordinate: float) -> Vector3:
	index=clampi(index,0,steering_count-1)
	var low := mini(int(coordinate),hike_count-2)
	return _cubic(values[index*hike_count+maxi(0,low-1)],values[index*hike_count+low],values[index*hike_count+low+1],values[index*hike_count+mini(hike_count-1,low+2)],coordinate-low)
func sample(steering: float,hike: float) -> Vector3:
